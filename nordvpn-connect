#!/usr/bin/env python
# -*- coding: utf-8 -*-
# NordVPN connect helper
# Usage: nordvpn-connect <country_id> <protocol>

import sys
import os
try:
    import urllib2
except ImportError:
    import urllib.request as urllib2
import json
import subprocess
import time

COUNTRY_ID   = int(sys.argv[1]) if len(sys.argv) > 1 else 81
PROTO        = sys.argv[2] if len(sys.argv) > 2 else "udp"
SERVER_TYPE  = sys.argv[3] if len(sys.argv) > 3 else "standard"
SKIP_HOSTS   = [h for h in sys.argv[4].split(",") if h] if len(sys.argv) > 4 else []
AUTH_FILE    = "/etc/openvpn/nordvpn_auth.txt"
OVPN_CONFIG  = "/etc/openvpn/nordvpn.conf"
PID_FILE     = "/var/run/openvpn.nordvpn.pid"
LOG_FILE     = "/var/log/nordvpn.log"
SERVER_FILE  = "/tmp/nordvpn_server.txt"
WATCHDOG_SKIP_FILE = "/tmp/nordvpn_watchdog_skip.txt"
CONFIG_FILE  = "/etc/enigma2/nordvpn.conf"
API_BASE     = "https://api.nordvpn.com/v1"

HOSTS_FILE   = "/etc/hosts"
HOSTS_MARKER = "# nordvpn-streaming-fix"
CDN_HOSTS    = ["nrodlzdf-a.akamaihd.net"]  # ZDF, 3sat, ZDFinfo, ZDFneo, Phoenix

AUTH_CHECK_DELAY = 4
MAX_ATTEMPTS = 10


WATCHDOG_PID  = "/var/run/nordvpn-watchdog.pid"
WATCHDOG_CMD  = "/usr/sbin/nordvpn-watchdog"
RESOLV_CONF   = "/etc/resolv.conf"
RESOLV_BACKUP = "/etc/resolv.conf.nordvpn.bak"
NORDVPN_DNS   = ["103.86.96.100", "103.86.99.100"]


def log(msg):
    print(msg)
    sys.stdout.flush()


def _get_streaming_fix():
    try:
        try:
            import ConfigParser
        except ImportError:
            import configparser as ConfigParser
        cfg = ConfigParser.SafeConfigParser()
        cfg.read(CONFIG_FILE)
        return cfg.get("nordvpn", "streaming_fix") == "1"
    except Exception:
        return False


def _clean_cdn_hosts():
    try:
        with open(HOSTS_FILE) as f:
            lines = f.readlines()
        clean = [l for l in lines if HOSTS_MARKER not in l]
        if len(clean) != len(lines):
            with open(HOSTS_FILE, "w") as f:
                f.writelines(clean)
    except Exception:
        pass


def _pre_resolve_cdn():
    import socket
    _clean_cdn_hosts()
    entries = []
    for host in CDN_HOSTS:
        try:
            ip = socket.gethostbyname(host)
            entries.append("%s %s %s\n" % (ip, host, HOSTS_MARKER))
            log("CDN pre-resolved: %s -> %s" % (host, ip))
        except Exception as e:
            log("WARNING: CDN-Aufloesung fehlgeschlagen fuer %s: %s" % (host, str(e)))
    if entries:
        with open(HOSTS_FILE, "a") as f:
            f.writelines(entries)


def _get_dns_servers():
    try:
        try:
            import ConfigParser
        except ImportError:
            import configparser as ConfigParser
        cfg = ConfigParser.SafeConfigParser()
        cfg.read(CONFIG_FILE)
        try:
            dns_type = cfg.get("nordvpn", "dns_type")
        except Exception:
            dns_type = "nordvpn"
    except Exception:
        dns_type = "nordvpn"

    if dns_type == "google":
        return ["8.8.8.8", "8.8.4.4"]
    elif dns_type == "cloudflare":
        return ["1.1.1.1", "1.0.0.1"]
    else:  # nordvpn or default
        return ["103.86.96.100", "103.86.99.100"]


def _set_dns():
    try:
        import shutil
        if not os.path.isfile(RESOLV_BACKUP):
            shutil.copy2(RESOLV_CONF, RESOLV_BACKUP)
        dns_servers = _get_dns_servers()
        with open(RESOLV_CONF, "w") as f:
            f.write("# NordVPN\n")
            for dns in dns_servers:
                f.write("nameserver %s\n" % dns)
        log("DNS set to %s" % ", ".join(dns_servers))
    except Exception as e:
        log("WARNING: Could not set DNS: %s" % str(e))


def _disable_ipv6():
    try:
        import glob
        save_states = not os.path.isfile("/tmp/nordvpn_ipv6_states")
        states = []
        for path in glob.glob("/proc/sys/net/ipv6/conf/*/disable_ipv6"):
            iface = path.split("/")[5]
            if iface != "lo":
                try:
                    with open(path, "r") as f:
                        orig = f.read().strip()
                    states.append("%s=%s" % (path, orig))
                except Exception:
                    pass
                with open(path, "w") as f:
                    f.write("1\n")
        if save_states and states:
            with open("/tmp/nordvpn_ipv6_states", "w") as f:
                f.write("\n".join(states) + "\n")
        log("IPv6 disabled and states backed up")
    except Exception as e:
        log("WARNING: Could not disable IPv6: %s" % str(e))


def _kill_all_watchdogs():
    try:
        for entry in os.listdir("/proc"):
            if not entry.isdigit():
                continue
            try:
                with open("/proc/%s/cmdline" % entry) as f:
                    cmdline = f.read()
            except Exception:
                continue
            if "nordvpn-watchdog" in cmdline:
                try:
                    os.kill(int(entry), 15)
                except Exception:
                    pass
    except Exception:
        pass


def _restart_watchdog():
    _kill_all_watchdogs()
    time.sleep(0.5)
    devnull = open(os.devnull, "w")
    subprocess.Popen(["python", WATCHDOG_CMD], stdout=devnull, stderr=devnull)


def _find_openvpn_pids():
    pids = []
    try:
        for entry in os.listdir("/proc"):
            if not entry.isdigit():
                continue
            try:
                with open("/proc/%s/cmdline" % entry) as f:
                    cmdline = f.read()
            except Exception:
                continue
            if "openvpn" in cmdline and OVPN_CONFIG in cmdline:
                pids.append(entry)
    except Exception:
        pass
    return pids


def stop_existing():
    # Killt alle laufenden OpenVPN-Prozesse mit unserer Config, nicht nur die
    # PID aus der Datei - verhindert verwaiste Tunnel nach einem unsauberen
    # E2-Neustart oder Race zwischen mehreren Connect-Versuchen.
    pids = _find_openvpn_pids()
    for pid in pids:
        try:
            os.kill(int(pid), 15)
        except Exception:
            pass
    if pids:
        log("Stopping %d existing connection(s)..." % len(pids))
        time.sleep(2)
    try:
        os.remove(PID_FILE)
    except Exception:
        pass


def fetch(url, timeout=15):
    req = urllib2.urlopen(url, timeout=timeout)
    return req.read()


def get_best_server():
    tech = "openvpn_%s" % PROTO
    limit = max(len(SKIP_HOSTS) + 3, 5)
    url = ("%s/servers/recommendations"
           "?filters[country_id]=%d"
           "&filters[servers_technologies][identifier]=%s"
           "&limit=%d") % (API_BASE, COUNTRY_ID, tech, limit)
    if SERVER_TYPE == "p2p":
        url += "&filters[servers_groups][identifier]=legacy_p2p"
    data = json.loads(fetch(url))
    if not data:
        return None
    for entry in data:
        if entry["hostname"] not in SKIP_HOSTS:
            return entry["hostname"]
    return None


def download_ovpn(hostname):
    if PROTO == "udp":
        url = ("https://downloads.nordcdn.com/configs/files/ovpn_udp"
               "/servers/%s.udp.ovpn") % hostname
    else:
        url = ("https://downloads.nordcdn.com/configs/files/ovpn_tcp"
               "/servers/%s.tcp.ovpn") % hostname
    return fetch(url, timeout=30)


def _record_failed_server(hostname):
    try:
        with open(WATCHDOG_SKIP_FILE) as f:
            skip = [h for h in f.read().strip().split(",") if h]
    except Exception:
        skip = []
    if hostname not in skip:
        skip.append(hostname)
    with open(WATCHDOG_SKIP_FILE, "w") as f:
        f.write(",".join(skip))


def attempt_connect(server):
    log("Connecting to: %s" % server)
    open(SERVER_FILE, "w").write(server)

    log("Downloading config...")
    try:
        ovpn = download_ovpn(server)
    except Exception as e:
        log("ERROR: Config-Download fehlgeschlagen fuer %s (%s), versuche naechsten Server..." % (server, str(e)))
        _record_failed_server(server)
        return False

    # Strip directives we override so there are no duplicates
    clean_lines = [
        l for l in ovpn.splitlines()
        if not l.strip().startswith("auth-user-pass")
        and l.strip() != "auth-nocache"
    ]
    ovpn_clean = "\n".join(clean_lines)

    extra = (
        "\nauth-user-pass %s"
        "\nlog-append %s"
        "\ntls-version-min 1.2"
        "\ntls-cipher TLS-ECDHE-RSA-WITH-AES-256-GCM-SHA384"
        ":TLS-ECDHE-RSA-WITH-AES-256-CBC-SHA384"
        ":TLS-ECDHE-RSA-WITH-AES-128-GCM-SHA256"
    ) % (AUTH_FILE, LOG_FILE)
    if PROTO == "udp":
        extra += "\nreplay-window 512 120"
    config = ovpn_clean + extra + "\n"

    with open(OVPN_CONFIG, "w") as f:
        f.write(config)
    os.chmod(OVPN_CONFIG, 0o600)

    if _get_streaming_fix():
        _pre_resolve_cdn()

    log_pos = os.path.getsize(LOG_FILE) if os.path.isfile(LOG_FILE) else 0

    log("Starting OpenVPN...")
    ret = subprocess.call([
        "/usr/sbin/openvpn",
        "--daemon",
        "--writepid", PID_FILE,
        "--config", OVPN_CONFIG,
    ])

    if ret != 0:
        log("ERROR: OpenVPN failed to start (exit %d)" % ret)
        sys.exit(1)

    success = False
    pid = ""
    for _ in range(40):  # Poll for up to 20 seconds (40 * 0.5s)
        time.sleep(0.5)

        # Check if process is still running
        pid_active = False
        try:
            with open(PID_FILE) as f:
                pid = f.read().strip()
            if pid and os.path.isdir("/proc/%s" % pid):
                pid_active = True
        except Exception:
            pass

        if not pid_active:
            log("ERROR: OpenVPN process terminated prematurely")
            break

        # Read log
        try:
            with open(LOG_FILE) as f:
                f.seek(log_pos)
                new_log = f.read()
        except Exception:
            new_log = ""

        if "AUTH_FAILED" in new_log:
            log("Server %s lehnt Zugangsdaten ab, versuche naechsten Server..." % server)
            try:
                os.kill(int(pid), 15)
            except Exception:
                pass
            try:
                os.remove(PID_FILE)
            except Exception:
                pass
            _record_failed_server(server)
            return False

        if "Initialization Sequence Completed" in new_log:
            log("SUCCESS: OpenVPN started, connecting to %s" % server)
            success = True
            break

    if not success:
        log("ERROR: Connection timed out or failed to establish")
        if pid:
            try:
                os.kill(int(pid), 15)
            except Exception:
                pass
        try:
            os.remove(PID_FILE)
        except Exception:
            pass
        return False

    try:
        rx, tx = 0, 0
        if os.path.isfile("/proc/net/dev"):
            with open("/proc/net/dev") as f:
                for line in f:
                    if "tun" in line:
                        parts = line.replace(":", " ").split()
                        if len(parts) > 9:
                            rx = int(parts[1])
                            tx = int(parts[9])
                        break
        with open("/tmp/nordvpn_session", "w") as f:
            f.write("%f %d %d" % (time.time(), rx, tx))
    except Exception:
        pass

    _disable_ipv6()
    _set_dns()
    _restart_watchdog()
    return True


def main():
    if not os.path.isfile(AUTH_FILE) or os.path.getsize(AUTH_FILE) < 5:
        log("ERROR: No credentials found at %s" % AUTH_FILE)
        log("Please configure your NordVPN Service Credentials in the plugin settings.")
        sys.exit(1)

    stop_existing()

    if not SKIP_HOSTS:
        try:
            os.remove(WATCHDOG_SKIP_FILE)
        except Exception:
            pass

    for attempt in range(MAX_ATTEMPTS):
        log("Fetching best server for country ID %d..." % COUNTRY_ID)
        try:
            server = get_best_server()
        except Exception as e:
            log("ERROR: NordVPN API unreachable (%s)" % str(e))
            sys.exit(1)

        if not server:
            log("ERROR: No server found for country ID %d" % COUNTRY_ID)
            sys.exit(1)

        if attempt_connect(server):
            return

        SKIP_HOSTS.append(server)

    log("ERROR: Kein Server verfuegbar nach %d Versuchen (Server offline oder Zugangsdaten abgelehnt)" % MAX_ATTEMPTS)
    sys.exit(1)


if __name__ == "__main__":
    main()
