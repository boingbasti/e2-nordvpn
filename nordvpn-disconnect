#!/bin/sh
# NordVPN disconnect helper

WATCHDOG_PID_FILE="/var/run/nordvpn-watchdog.pid"
if [ -f "$WATCHDOG_PID_FILE" ]; then
    kill "$(cat $WATCHDOG_PID_FILE 2>/dev/null)" 2>/dev/null || true
    rm -f "$WATCHDOG_PID_FILE"
fi

rm -f /tmp/nordvpn_watchdog_skip.txt

RESOLV_BACKUP="/etc/resolv.conf.nordvpn.bak"
if [ -f "$RESOLV_BACKUP" ]; then
    cp "$RESOLV_BACKUP" /etc/resolv.conf
    rm -f "$RESOLV_BACKUP"
    echo "DNS restored"
fi

for f in /proc/sys/net/ipv6/conf/*/disable_ipv6; do
    iface=$(echo "$f" | cut -d/ -f6)
    [ "$iface" != "lo" ] && echo 0 > "$f"
done
echo "IPv6 restored"

if grep -q "# nordvpn-streaming-fix" /etc/hosts 2>/dev/null; then
    grep -v "# nordvpn-streaming-fix" /etc/hosts > /tmp/hosts.tmp && mv /tmp/hosts.tmp /etc/hosts
    echo "Streaming-Fix entfernt"
fi

PID_FILE="/var/run/openvpn.nordvpn.pid"

if [ ! -f "$PID_FILE" ]; then
    echo "Not connected"
    exit 0
fi

PID=$(cat "$PID_FILE" 2>/dev/null)
if [ -n "$PID" ] && [ -d "/proc/$PID" ]; then
    kill "$PID" 2>/dev/null
    sleep 1
    if [ -d "/proc/$PID" ]; then
        kill -9 "$PID" 2>/dev/null
    fi
fi

rm -f "$PID_FILE"
rm -f /etc/openvpn/nordvpn.conf
echo "Disconnected"
