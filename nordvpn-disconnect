#!/bin/sh
# NordVPN disconnect helper

# Nur echte Watchdog-Prozesse (python + Skriptpfad als erstes Argument), nicht
# jede Shell, in deren Kommandozeile der Name zufaellig vorkommt
for pid in $(ls /proc 2>/dev/null | grep -E '^[0-9]+$'); do
    ARG0=$(tr '\0' '\n' 2>/dev/null < "/proc/$pid/cmdline" | sed -n 1p)
    ARG1=$(tr '\0' '\n' 2>/dev/null < "/proc/$pid/cmdline" | sed -n 2p)
    case "$ARG0" in
        *python*)
            if [ "$ARG1" = "/usr/sbin/nordvpn-watchdog" ]; then
                kill "$pid" 2>/dev/null
            fi
            ;;
    esac
done
rm -f /var/run/nordvpn-watchdog.pid

# Laufenden Verbindungsaufbau beenden (z.B. "Abbrechen" im Plugin), damit er
# nach dem Trennen nicht doch noch einen Tunnel startet
for pid in $(ls /proc 2>/dev/null | grep -E '^[0-9]+$'); do
    ARG0=$(tr '\0' '\n' 2>/dev/null < "/proc/$pid/cmdline" | sed -n 1p)
    ARG1=$(tr '\0' '\n' 2>/dev/null < "/proc/$pid/cmdline" | sed -n 2p)
    case "$ARG0" in
        *python*)
            if [ "$ARG1" = "/usr/sbin/nordvpn-connect" ]; then
                kill "$pid" 2>/dev/null
            fi
            ;;
    esac
done

rm -f /tmp/nordvpn_watchdog_skip.txt

RESOLV_BACKUP="/etc/resolv.conf.nordvpn.bak"
if [ -f "$RESOLV_BACKUP" ]; then
    # Eine Sicherung mit "# NordVPN" enthaelt VPN-DNS statt des Originals
    if [ "$(head -n1 "$RESOLV_BACKUP")" != "# NordVPN" ]; then
        cp "$RESOLV_BACKUP" /etc/resolv.conf
        echo "DNS restored"
    fi
    rm -f "$RESOLV_BACKUP"
fi

# IPv6 so setzen, wie es das System beim Booten selbst tun wuerde, statt
# einer evtl. veralteten Sicherung zu vertrauen. openATV ("Nur IPv4" in den
# Netzwerkeinstellungen) kommentiert die inet6-Zeile in /etc/network/interfaces
# aus, und sein if-up-Hook schaltet IPv6 fuer dieses Interface dann ab. Der
# VTi-Hook macht das nicht, dort ist IPv6 auch bei auskommentierter Zeile an.
rm -f /tmp/nordvpn_ipv6_states
IPV4_ONLY_HOOK=0
grep -q "disable_ipv6=1" /etc/network/if-up.d/odhcp6c 2>/dev/null && IPV4_ONLY_HOOK=1
for f in /proc/sys/net/ipv6/conf/all/disable_ipv6 /proc/sys/net/ipv6/conf/default/disable_ipv6; do
    [ -f "$f" ] && echo 0 > "$f"
done
for f in /proc/sys/net/ipv6/conf/*/disable_ipv6; do
    iface=$(echo "$f" | cut -d/ -f7)
    case "$iface" in
        all|default|lo) continue ;;
    esac
    val=0
    if [ "$IPV4_ONLY_HOOK" = "1" ] && \
       grep -Eq "^#[[:space:]]*iface[[:space:]]+${iface}[[:space:]]+inet6" /etc/network/interfaces 2>/dev/null; then
        val=1
    fi
    echo "$val" > "$f"
done
if [ "$IPV4_ONLY_HOOK" = "1" ] && grep -Eq "^#[[:space:]]*iface[[:space:]]+eth0[[:space:]]+inet6" /etc/network/interfaces 2>/dev/null; then
    echo "IPv6 bleibt aus (Nur IPv4)"
else
    echo "IPv6 aktiviert"
fi

if grep -q "# nordvpn-streaming-fix" /etc/hosts 2>/dev/null; then
    grep -v "# nordvpn-streaming-fix" /etc/hosts > /tmp/hosts.tmp && mv /tmp/hosts.tmp /etc/hosts
    echo "Streaming-Fix entfernt"
fi

PID_FILE="/var/run/openvpn.nordvpn.pid"

# Killt alle laufenden OpenVPN-Prozesse mit der Plugin-Config, nicht nur die
# PID aus der Datei - findet auch verwaiste Tunnel ohne (oder mit
# veralteter) PID-Datei, z.B. nach einem unsauberen E2-Neustart.
KILLED=0
for pid in $(ls /proc 2>/dev/null | grep -E '^[0-9]+$'); do
    if grep -q "openvpn" "/proc/$pid/cmdline" 2>/dev/null && grep -qE "/etc/openvpn/nordvpn\.(ovpn|conf)" "/proc/$pid/cmdline" 2>/dev/null; then
        kill "$pid" 2>/dev/null
        KILLED=1
    fi
done

if [ "$KILLED" = "1" ]; then
    sleep 1
    for pid in $(ls /proc 2>/dev/null | grep -E '^[0-9]+$'); do
        if grep -q "openvpn" "/proc/$pid/cmdline" 2>/dev/null && grep -qE "/etc/openvpn/nordvpn\.(ovpn|conf)" "/proc/$pid/cmdline" 2>/dev/null; then
            kill -9 "$pid" 2>/dev/null
        fi
    done
fi

rm -f "$PID_FILE"
rm -f /etc/openvpn/nordvpn.ovpn /etc/openvpn/nordvpn.conf

if ip link show tun0 >/dev/null 2>&1; then
    ip link delete tun0 2>/dev/null || true
    echo "tun0 entfernt"
fi

if [ "$KILLED" = "1" ]; then
    echo "Disconnected"
else
    echo "Not connected"
fi
