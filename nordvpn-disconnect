#!/bin/sh
# NordVPN disconnect helper

for pid in $(ls /proc 2>/dev/null | grep -E '^[0-9]+$'); do
    if grep -q "nordvpn-watchdog" "/proc/$pid/cmdline" 2>/dev/null; then
        kill "$pid" 2>/dev/null
    fi
done
rm -f /var/run/nordvpn-watchdog.pid

rm -f /tmp/nordvpn_watchdog_skip.txt

RESOLV_BACKUP="/etc/resolv.conf.nordvpn.bak"
if [ -f "$RESOLV_BACKUP" ]; then
    cp "$RESOLV_BACKUP" /etc/resolv.conf
    rm -f "$RESOLV_BACKUP"
    echo "DNS restored"
fi

IPV6_STATE_FILE="/tmp/nordvpn_ipv6_states"
if [ -f "$IPV6_STATE_FILE" ]; then
    while IFS='=' read -r path val; do
        if [ -f "$path" ]; then
            echo "$val" > "$path"
        fi
    done < "$IPV6_STATE_FILE"
    rm -f "$IPV6_STATE_FILE"
    echo "IPv6 states restored from backup"
else
    for f in /proc/sys/net/ipv6/conf/*/disable_ipv6; do
        iface=$(echo "$f" | cut -d/ -f6)
        [ "$iface" != "lo" ] && echo 0 > "$f"
    done
    echo "IPv6 restored (fallback)"
fi

if grep -q "# nordvpn-streaming-fix" /etc/hosts 2>/dev/null; then
    grep -v "# nordvpn-streaming-fix" /etc/hosts > /tmp/hosts.tmp && mv /tmp/hosts.tmp /etc/hosts
    echo "Streaming-Fix entfernt"
fi

PID_FILE="/var/run/openvpn.nordvpn.pid"

# Killt alle laufenden OpenVPN-Prozesse mit unserer Config, nicht nur die
# PID aus der Datei - findet auch verwaiste Tunnel ohne (oder mit
# veralteter) PID-Datei, z.B. nach einem unsauberen E2-Neustart.
KILLED=0
for pid in $(ls /proc 2>/dev/null | grep -E '^[0-9]+$'); do
    if grep -q "openvpn" "/proc/$pid/cmdline" 2>/dev/null && grep -q "nordvpn.conf" "/proc/$pid/cmdline" 2>/dev/null; then
        kill "$pid" 2>/dev/null
        KILLED=1
    fi
done

if [ "$KILLED" = "1" ]; then
    sleep 1
    for pid in $(ls /proc 2>/dev/null | grep -E '^[0-9]+$'); do
        if grep -q "openvpn" "/proc/$pid/cmdline" 2>/dev/null && grep -q "nordvpn.conf" "/proc/$pid/cmdline" 2>/dev/null; then
            kill -9 "$pid" 2>/dev/null
        fi
    done
fi

rm -f "$PID_FILE"
rm -f /etc/openvpn/nordvpn.conf

if [ "$KILLED" = "1" ]; then
    echo "Disconnected"
else
    echo "Not connected"
fi
