#!/usr/bin/env python
# -*- coding: utf-8 -*-
import os
import sys
import time
import subprocess
import traceback
try:
    import ConfigParser
except ImportError:
    import configparser as ConfigParser

PID_FILE    = "/var/run/openvpn.nordvpn.pid"
CONNECT_CMD = "/usr/sbin/nordvpn-connect"
CONFIG_FILE = "/etc/enigma2/nordvpn.conf"
SELF_PID    = "/var/run/nordvpn-watchdog.pid"
SERVER_FILE = "/tmp/nordvpn_server.txt"
SKIP_FILE   = "/tmp/nordvpn_watchdog_skip.txt"
ERROR_LOG   = "/var/log/nordvpn-watchdog-error.log"
INTERVAL = 60
FAST_INTERVAL = 10
FAST_DURATION = 120


def is_vpn_connected():
    if not os.path.isfile(PID_FILE):
        return False
    try:
        pid = open(PID_FILE).read().strip()
        return bool(pid) and os.path.isdir("/proc/%s" % pid)
    except Exception:
        return False


def read_config():
    cfg = ConfigParser.SafeConfigParser()
    cfg.read(CONFIG_FILE)
    try:
        country_id = cfg.get("nordvpn", "country_id")
    except Exception:
        country_id = "81"
    try:
        proto = cfg.get("nordvpn", "protocol")
    except Exception:
        proto = "udp"
    try:
        server_type = cfg.get("nordvpn", "server_type")
    except Exception:
        server_type = "standard"
    return country_id, proto, server_type


def read_skip_list():
    try:
        with open(SKIP_FILE) as f:
            return [h for h in f.read().strip().split(",") if h]
    except Exception:
        return []


def add_failed_server():
    try:
        with open(SERVER_FILE) as f:
            failed = f.read().strip()
    except Exception:
        return
    if not failed:
        return
    skip = read_skip_list()
    if failed not in skip:
        skip.append(failed)
    with open(SKIP_FILE, "w") as f:
        f.write(",".join(skip))


def _log_error():
    try:
        with open(ERROR_LOG, "a") as f:
            f.write(time.strftime("%a %b %d %H:%M:%S %Y") + "\n")
            f.write(traceback.format_exc())
            f.write("\n")
    except Exception:
        pass


def main():
    open(SELF_PID, "w").write(str(os.getpid()))
    was_connected = is_vpn_connected()
    start_time = time.time()
    while True:
        try:
            elapsed = time.time() - start_time
            interval = FAST_INTERVAL if elapsed < FAST_DURATION else INTERVAL
            time.sleep(interval)
            connected = is_vpn_connected()
            if connected:
                was_connected = True
                continue
            if not was_connected:
                continue
            add_failed_server()
            country_id, proto, server_type = read_config()
            skip = read_skip_list()
            subprocess.Popen(["python", CONNECT_CMD, country_id, proto, server_type, ",".join(skip)])
        except Exception:
            _log_error()
            time.sleep(5)


if __name__ == "__main__":
    main()
