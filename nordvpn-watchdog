#!/usr/bin/env python
# -*- coding: utf-8 -*-
import os
import sys
import time
import subprocess
import traceback
try:
    import ConfigParser
except ImportError:
    import configparser as ConfigParser

PID_FILE    = "/var/run/openvpn.nordvpn.pid"
CONNECT_CMD = "/usr/sbin/nordvpn-connect"
CONFIG_FILE = "/etc/enigma2/nordvpn.conf"
SELF_PID    = "/var/run/nordvpn-watchdog.pid"
SERVER_FILE = "/tmp/nordvpn_server.txt"
SKIP_FILE   = "/tmp/nordvpn_watchdog_skip.txt"
ERROR_LOG   = "/var/log/nordvpn-watchdog-error.log"
CONNECT_LOG = "/var/log/nordvpn-connect.log"
INTERVAL = 60
FAST_INTERVAL = 10
FAST_DURATION = 120


def is_vpn_connected():
    if not os.path.isfile(PID_FILE):
        return False
    try:
        pid = open(PID_FILE).read().strip()
        return bool(pid) and os.path.isdir("/proc/%s" % pid)
    except Exception:
        return False


def read_vpn_pid():
    try:
        return open(PID_FILE).read().strip()
    except Exception:
        return ""


def has_tunnel_route():
    # Default-Route ueber ein tun-Interface: redirect-gateway def1 legt
    # 0.0.0.0/1 und 128.0.0.0/1 an, ohne def1 ersetzt OpenVPN 0.0.0.0/0.
    # Alle drei haben in /proc/net/route das Ziel 00000000.
    try:
        with open("/proc/net/route") as f:
            for line in f.readlines()[1:]:
                parts = line.split()
                if len(parts) > 7 and parts[0].startswith("tun") and parts[1] == "00000000":
                    return True
    except Exception:
        pass
    return False


def log(msg):
    try:
        with open(CONNECT_LOG, "a") as f:
            f.write(time.strftime("%Y-%m-%d %H:%M:%S ") + msg + "\n")
    except Exception:
        pass


def is_connect_running():
    # Laeuft bereits ein Verbindungsaufbau (Autostart, Plugin oder eigener
    # Reconnect), keinen zweiten starten - sonst entstehen parallele Tunnel.
    own = str(os.getpid())
    try:
        for entry in os.listdir("/proc"):
            if not entry.isdigit() or entry == own:
                continue
            try:
                with open("/proc/%s/cmdline" % entry) as f:
                    cmdline = f.read()
            except Exception:
                continue
            args = cmdline.split("\0")
            if len(args) > 1 and "python" in args[0] and args[1] == CONNECT_CMD:
                return True
    except Exception:
        pass
    return False


def read_config():
    cfg = ConfigParser.RawConfigParser()
    cfg.read(CONFIG_FILE)
    try:
        country_id = cfg.get("nordvpn", "country_id")
    except Exception:
        country_id = "81"
    try:
        proto = cfg.get("nordvpn", "protocol")
    except Exception:
        proto = "udp"
    try:
        server_type = cfg.get("nordvpn", "server_type")
    except Exception:
        server_type = "standard"
    return country_id, proto, server_type


def read_skip_list():
    try:
        with open(SKIP_FILE) as f:
            return [h for h in f.read().strip().split(",") if h]
    except Exception:
        return []


def add_failed_server():
    try:
        with open(SERVER_FILE) as f:
            failed = f.read().strip()
    except Exception:
        return
    if not failed:
        return
    skip = read_skip_list()
    if failed not in skip:
        skip.append(failed)
    with open(SKIP_FILE, "w") as f:
        f.write(",".join(skip))


def _log_error():
    try:
        with open(ERROR_LOG, "a") as f:
            f.write(time.strftime("%a %b %d %H:%M:%S %Y") + "\n")
            f.write(traceback.format_exc())
            f.write("\n")
    except Exception:
        pass


def _daemonize():
    # Doppel-Fork, damit dieser Dauerprozess sofort von init (PID 1) statt von
    # Enigma2 geerbt wird. Enigma2 selbst wartet in bestimmten Situationen
    # blockierend auf irgendein eigenes Kind (waitpid(-1, ...) statt auf die
    # konkrete PID) - ein Dauerprozess, der als direktes Kind von Enigma2
    # haengen bleibt, kann Enigma2 dadurch komplett einfrieren (beobachtet auf
    # VTi16). Ohne Reparenting auf init ist das reine Glueckssache je nach
    # Timing/Image-Version.
    if os.fork() > 0:
        os._exit(0)
    os.setsid()
    if os.fork() > 0:
        os._exit(0)
    devnull_fd = os.open(os.devnull, os.O_RDWR)
    os.dup2(devnull_fd, 0)
    os.dup2(devnull_fd, 1)
    os.dup2(devnull_fd, 2)


def main():
    _daemonize()
    open(SELF_PID, "w").write(str(os.getpid()))
    was_connected = is_vpn_connected()
    start_time = time.time()
    reconnect_proc = None
    # PID der OpenVPN-Instanz, bei der die Tunnel-Route schon einmal da war.
    # Erst dann gilt eine fehlende Route als Fehler, damit eigene Configs ohne
    # Umleitung des gesamten Verkehrs keine Dauer-Reconnects ausloesen.
    route_seen_pid = None
    while True:
        try:
            elapsed = time.time() - start_time
            interval = FAST_INTERVAL if elapsed < FAST_DURATION else INTERVAL
            time.sleep(interval)
            if reconnect_proc is not None and reconnect_proc.poll() is None:
                continue
            connected = is_vpn_connected()
            if connected:
                was_connected = True
                reconnect_proc = None
                vpn_pid = read_vpn_pid()
                if has_tunnel_route():
                    route_seen_pid = vpn_pid
                elif route_seen_pid == vpn_pid and not is_connect_running():
                    # OpenVPN laeuft noch, aber Adresse und Routen des Tunnels
                    # sind weg (z. B. nach "Netzwerk neu starten" im Image).
                    # Der Verkehr liefe dann ungeschuetzt am Tunnel vorbei,
                    # und OpenVPN merkt das selbst nicht.
                    log("Watchdog: Tunnel-Routen fehlen (z.B. Netzwerk neu gestartet), verbinde neu")
                    route_seen_pid = None
                    country_id, proto, server_type = read_config()
                    reconnect_proc = subprocess.Popen([sys.executable or "python", CONNECT_CMD, country_id, proto, server_type, ""])
                    start_time = time.time()
                continue
            if not was_connected:
                continue
            if is_connect_running():
                continue
            add_failed_server()
            country_id, proto, server_type = read_config()
            skip = read_skip_list()
            reconnect_proc = subprocess.Popen([sys.executable or "python", CONNECT_CMD, country_id, proto, server_type, ",".join(skip)])
            start_time = time.time()
        except Exception:
            _log_error()
            time.sleep(5)


if __name__ == "__main__":
    main()
