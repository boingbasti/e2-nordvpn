#!/usr/bin/env python
# -*- coding: utf-8 -*-
# nordvpn-webif - Temporaerer Webserver fuer Zugangsdaten-Eingabe

import os
import sys
import signal
import urllib
import threading
from BaseHTTPServer import HTTPServer, BaseHTTPRequestHandler

PORT       = int(sys.argv[1]) if len(sys.argv) > 1 else 8765
AUTH_FILE  = "/etc/openvpn/nordvpn_auth.txt"
PID_FILE   = "/var/run/nordvpn-webif.pid"
PLUGIN_PNG = "/usr/lib/enigma2/python/Plugins/Extensions/NordVPN/plugin.png"
TIMEOUT    = 300

HTML = u"""<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>NordVPN Zugangsdaten</title>
<style>
* { box-sizing: border-box; }
body { font-family: Arial, sans-serif; max-width: 420px; margin: 40px auto; padding: 20px; background: #f4f5f7; }
h2 { color: #2d3250; margin-top: 8px; }
.info { color: #555; font-size: 13px; background: #e8eaf0; border-left: 3px solid #4ecdc4; padding: 10px 12px; border-radius: 4px; margin-bottom: 20px; }
label { font-weight: bold; display: block; margin-bottom: 4px; color: #2d3250; }
input { width: 100%; padding: 10px; margin-bottom: 16px; border: 1px solid #c0c4d6; border-radius: 4px; font-size: 15px; background: #fff; }
input:focus { outline: none; border-color: #4ecdc4; }
